generator client {
  // Cliente estándar de Prisma: import { PrismaClient } from '@prisma/client'
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enum alineado con tu PlayerCategory de dominio
enum PlayerCategory {
  CUARTA
  TERCERA
  SEGUNDA
  PRIMERA
  ELITE
}

// Rol para autorización: USER (registro público), ADMIN (solo otro ADMIN puede asignarlo)
enum PlayerRole {
  USER
  ADMIN
}

// Posición de un jugador en una plantilla
enum Position {
  PORTERO
  DELANTERO
}

// Modelo Player alineado con tu entidad y VOs
model Player {
  // Identidad: PlayerId (UUID v7 en dominio) → uuid en Postgres
  id          String   @id @db.Uuid

  // Email único (invariante de dominio + UNIQUE en BD)
  email       String   @unique

  name        String
  lastname    String
  nickname    String?      // string | null en dominio

  // PhoneNumber: almacenas solo dígitos como string
  phoneNumber String

  // Birthdate: DateTime en BD, Birthdate VO en dominio
  birthdate   DateTime

  // Category: string en BD, PlayerCategory VO en dominio
  category    PlayerCategory

  // Rol: USER por defecto en registro; solo ADMIN puede asignar ADMIN a otro
  role        PlayerRole @default(USER)

  // Hash de contraseña (nunca en claro). Requerido para login.
  passwordHash String

  // Auditoría básica (opcional pero útil)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relación 1-N con RosterPlayer (plantillas en las que participa)
  rosterPlayers RosterPlayer[]
}

model League {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  leagueCategory String  // ELITE, PRO, AVANZADO, MASTER, PRIMERA, SEGUNDA, TERCERA, CUARTA

  seasons       Season[]
}

model Team {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())

  teamSeasons        TeamSeason[]
  seasonsAsChampion  Season[]    @relation("Champion")
  seasonsAsSecond   Season[]    @relation("Second")
}

model Season {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  year       Int
  leagueId   String  @db.Uuid
  championId String? @db.Uuid
  secondId   String? @db.Uuid

  league     League   @relation(fields: [leagueId], references: [id], onDelete: Restrict)
  champion   Team?    @relation("Champion", fields: [championId], references: [id], onDelete: SetNull)
  second     Team?    @relation("Second", fields: [secondId], references: [id], onDelete: SetNull)
  teamSeasons TeamSeason[]

  @@unique([leagueId, year])
}

model TeamSeason {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId   String @db.Uuid
  seasonId String @db.Uuid

  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season        Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  rosterPlayers RosterPlayer[]

  @@unique([teamId, seasonId])
}

model RosterPlayer {
  teamSeasonId String   @db.Uuid
  playerId     String   @db.Uuid
  position     Position

  teamSeason TeamSeason @relation(fields: [teamSeasonId], references: [id], onDelete: Cascade)
  player     Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([teamSeasonId, playerId])
}
