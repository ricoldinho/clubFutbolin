# Base de datos (desarrollo)
# Prisma CLI y la app usan DATABASE_URL.
# Variables usadas por docker-compose.yml
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clubfutbolin
DATABASE_URL="postgresql://user:password@localhost:5432/clubfutbolin"

# Base de datos solo para tests de integración y e2e.
# En local: usar el Postgres del docker-compose.test.yml (puerto 5433).
#   docker compose -f docker-compose.test.yml up -d
DATABASE_URL_TEST="postgresql://test:test@localhost:5433/clubfutbolin_test"

# Entorno (opcional)
# NODE_ENV=development

# JWT para autenticación (obligatorio en producción)
# JWT_SECRET=dev-secret-change-in-production
# JWT_EXPIRES_IN=7d

# Seed Prisma (opcional)
# PRISMA_SEED_RANDOM_SEED=42
# PRISMA_SEED_ADMIN_PASSWORD=admin123456
# PRISMA_SEED_USER_PASSWORD=user123456
