# Base de datos (desarrollo)
# Prisma CLI y la app usan DATABASE_URL.
# Variables usadas por docker-compose.yml
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=clubfutbolin
DATABASE_URL="postgresql://user:password@localhost:5432/clubfutbolin"

# Base de datos solo para tests de integración y e2e.
# En local: usar el Postgres del docker-compose.test.yml (puerto 5433).
#   docker compose -f docker-compose.test.yml up -d
DATABASE_URL_TEST="postgresql://test:test@localhost:5433/clubfutbolin_test"

# Entorno (opcional)
# NODE_ENV=development

# JWT para autenticación
# JWT_SECRET debe tener longitud mínima 32
JWT_SECRET=dev-secret-change-in-production-1234567890
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=14d

# Seguridad HTTP / sesiones
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_ACCESS_COOKIE_NAME=clubfutbolin_at
AUTH_REFRESH_COOKIE_NAME=clubfutbolin_rt
AUTH_ACCESS_COOKIE_MAX_AGE_SEC=900
AUTH_REFRESH_COOKIE_MAX_AGE_SEC=1209600
AUTH_COOKIE_SAME_SITE=lax
# En producción debe ser true (el servidor aborta en producción si permanece false)
AUTH_COOKIE_SECURE=false
AUTH_CSRF_COOKIE_NAME=clubfutbolin_csrf
AUTH_CSRF_HEADER_NAME=x-csrf-token

# Reverse proxy (Nginx/Cloudflare/Ingress)
# true en producción detrás de proxy para resolver IP real del cliente
TRUST_PROXY=false

# Seed Prisma (opcional)
# PRISMA_SEED_RANDOM_SEED=42
# PRISMA_SEED_ADMIN_PASSWORD=admin123456
# PRISMA_SEED_USER_PASSWORD=user123456
